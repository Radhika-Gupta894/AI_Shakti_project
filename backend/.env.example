# Database Connection (Cloud PostgreSQL - Neon/Supabase)
# Format: postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Note: Use postgresql+pg8000:// if you don't have C++ build tools installed
DATABASE_URL=postgresql://neondb_owner:password@ep-odd-dawn.us-east-1.aws.neon.tech/neondb?sslmode=require

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OCR Configuration
TESSERACT_CMD_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
